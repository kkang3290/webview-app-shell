<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- Native chrome mirrors the configured startup theme until the WebView takes over. -->
    <style name="AppTheme" parent="Theme.AppCompat.Light.DarkActionBar">
        <item name="colorPrimary">@color/appshell_startup_ink</item>
        <item name="colorPrimaryDark">@color/appshell_startup_background</item>
        <item name="colorAccent">@color/appshell_startup_active</item>
    </style>

    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="colorPrimary">@color/appshell_startup_ink</item>
        <item name="colorPrimaryDark">@color/appshell_startup_background</item>
        <item name="colorAccent">@color/appshell_startup_active</item>
        <item name="android:colorBackground">@color/appshell_startup_background</item>
        <item name="android:windowBackground">@color/appshell_startup_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@color/appshell_startup_navigation_bar</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">true</item>
    </style>

    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/appshell_startup_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/appshell_splash_mark</item>
        <item name="windowSplashScreenAnimationDuration">0</item>
        <item name="postSplashScreenTheme">@style/AppTheme.NoActionBar</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@color/appshell_startup_navigation_bar</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">true</item>
    </style>
</resources>
