{
  "schemaVersion": 1,
  "engine": "webview",
  "app": { "name": "ExampleApp", "version": "1.0.0" },
  "web": {
    "command": ["npm", "run", "build"],
    "outDir": "dist",
    "version": { "packageJson": "package.json" }
  },
